# Copy to .env and fill in.
DATABASE_URL=sqlite:///./linkvault.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/linkvault
SECRET_KEY=replace-with-a-long-random-string
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-haiku-5-5
# Summaries are written by Claude from the video's captions / page text.
ENABLE_TRANSCRIPTS=true
# Speech-to-text for videos without captions (slow; needs pip install faster-whisper)
ENABLE_WHISPER=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_MAX_MINUTES=120
# Optional: Meta app token "APP_ID|CLIENT_TOKEN" for Instagram/Facebook oEmbed
META_OEMBED_TOKEN=
# Where uploaded screenshots are stored
FILES_DIR=./uploads
# Set to false after you've created your account
ALLOW_REGISTRATION=true
# Language for descriptions, summaries and recipes (other languages get translated)
SUMMARY_LANGUAGE=English
SUMMARY_LANGUAGE_CODE=en
